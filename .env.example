# Database (Neon on Vercel)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Vercel Postgres alternative env var name
# POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# Payload
PAYLOAD_SECRET=your-long-random-secret-at-least-32-chars

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Server URL (set in Vercel to your production domain)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Seed initial content (run once after deploy):
# GET /api/seed?secret=<PAYLOAD_SECRET>
